"""benbirt.io: Ben Birt's personal site."""

module(name = "benbirt_io")

bazel_dep(name = "aspect_rules_js", version = "3.6.1")
bazel_dep(name = "platforms", version = "1.1.0")

# Formatting and Starlark lint from benbirt/bazel-style: bazel run
# //tools:format, //tools:format.check and //tools:lint.
bazel_dep(name = "bazel_style", version = "0.0.0", dev_dependency = True)
git_override(
    module_name = "bazel_style",
    commit = "bc60126ccfc3e45b9ef984771b8a34457aea0dbd",
    remote = "https://github.com/benbirt/bazel-style.git",
)

# Zola, the static site generator, as its released binaries. The version and
# the sha256s are kept up to date by tools/zola/update.sh, which a weekly
# workflow runs.
ZOLA_VERSION = "0.23.6"

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

[
    http_archive(
        name = "zola_" + name,
        build_file_content = 'exports_files(["zola"])',
        sha256 = sha256,
        url = "https://github.com/getzola/zola/releases/download/v{v}/zola-v{v}-{triple}.tar.gz".format(
            triple = triple,
            v = ZOLA_VERSION,
        ),
    )
    for name, triple, sha256 in [
        # musl: statically linked, so it also runs on NixOS.
        ("linux_x86_64", "x86_64-unknown-linux-musl", "7d77a4220a4f699cba2fc0e0c7859f780e887e269159ad4fab90e11ea16c906f"),
        ("macos_arm64", "aarch64-apple-darwin", "cbffbd29b3f59c3f52633507c8cb945a7a02d8b1399b43b235f5932912297aa3"),
    ]
]

# The domain's DNS and email routing as OpenTofu (infra/), through rules_tofu.
bazel_dep(name = "rules_tofu", version = "0.7.0")

tofu = use_extension("@rules_tofu//toolchain:extensions.bzl", "tofu")
use_repo(tofu, "tofu_toolchains")

# Provider versions are pinned in infra/main.tf and infra/.terraform.lock.hcl,
# as in a plain OpenTofu project, so Dependabot can update them. After changing
# a version in main.tf, rewrite the lock with:
#   bazel run @tf_providers//:pin
tf_providers = use_extension("@rules_tofu//tf/providers:extensions.bzl", "tf_providers")
tf_providers.from_lock(lock_file = "//infra:.terraform.lock.hcl")
use_repo(tf_providers, "tf_providers")

# The site's one npm dependency, posthog-js, loaded by site/static/analytics.js
# to count visits. It is pinned in package.json and pnpm-lock.yaml so
# Dependabot can update it. To change the version by hand:
#   bazel run -- @pnpm//:pnpm --dir $PWD add --save-exact --lockfile-only posthog-js@<version>
pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm", dev_dependency = True)
pnpm.pnpm(pnpm_version_from = "//:package.json")
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm", dev_dependency = True)
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
)

# rules_js drops documentation from packages, licences included. Keep the
# whole of posthog-js, so that its licence can be served with it.
npm.npm_exclude_package_contents(
    package = "posthog-js",
    presets = [],
)
use_repo(npm, "npm")
