# Maintainer tools for formatting and linting.
load("@aspect_rules_lint//format:defs.bzl", "format_multirun")
load("@buildifier_prebuilt//:rules.bzl", "buildifier")

# Formats git-tracked shell and Starlark files via rules_lint:
# `bazel run //tools:format` rewrites files; `:format.check` checks them.
format_multirun(
    name = "format",
    shell = "@aspect_rules_lint//format:shfmt",
    starlark = "@buildifier_prebuilt//:buildifier",
)

# Lints every Starlark file under the workspace via `bazel run //tools:lint`,
# including untracked files; fails on any lint warning or formatting diff.
# Excludes `.git` so refs like `fix/BUILD` are not matched. Suppress
# deliberate warnings inline with `# buildifier: disable=<warning>` and a
# reason; buildifier reads no ignore file.
buildifier(
    name = "lint",
    exclude_patterns = ["./.git/*"],
    lint_mode = "warn",
    mode = "check",
)
