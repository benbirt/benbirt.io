"""The Zola binary for the host platform."""

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
    ],
)

alias(
    name = "zola",
    actual = select(
        {
            ":linux_x86_64": "@zola_linux_x86_64//:zola",
            ":macos_arm64": "@zola_macos_arm64//:zola",
        },
        no_match_error = "Zola is only set up for Linux x86_64 and macOS arm64: see MODULE.bazel.",
    ),
    visibility = ["//visibility:public"],
)
